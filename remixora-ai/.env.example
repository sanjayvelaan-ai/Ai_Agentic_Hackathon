# Copy to .env. Do not commit secrets.
DEPLOY_MODE=development
AUTH_USER=creator
AUTH_PASSWORD=CHOOSE_A_LONG_RANDOM_PASSWORD
DATA_DIR=/data
MAX_UPLOAD_MB=150
MAX_DURATION_SECONDS=1800
FFMPEG_TIMEOUT_SECONDS=600
WITH_WHISPER=0
WHISPER_MODEL=tiny
TRANSCRIPTION_BACKEND=none
WHISPER_CPP_BIN=whisper-cli
WHISPER_CPP_MODEL=
AI_PROVIDER=none
STORAGE_QUOTA_MB=5000
PUBLIC_ORIGIN=
# Optional: verify a free-eligible Gemini model in YOUR account
GEMINI_API_KEY=''
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional local OpenAI-compatible Ollama endpoint
OLLAMA_URL=
OLLAMA_MODEL=
# Required only for Docker Compose profile 'public' (real DNS name)
DOMAIN=your-hostname.example.org
