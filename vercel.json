{
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py?__path=$1"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "env": {
    "AI_PROVIDER": "gemini",
    "GEMINI_MODEL": "gemini-flash-lite-latest",
    "DATA_DIR": "/tmp/data",
    "MAX_UPLOAD_MB": "50"
  }
}
